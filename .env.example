# Public Supabase project values (use a separate project per environment).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never expose these with NEXT_PUBLIC_ prefixes.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
MENU_IMPORT_AUTOMATION_SECRET=
# Optional Gemini multimodal structuring. These are server-only and must never
# use NEXT_PUBLIC_ prefixes. GEMINI_KEY remains supported for local compatibility.
MENU_IMPORT_GEMINI_API_KEY=
GEMINI_KEY=
MENU_IMPORT_GEMINI_MODEL=gemini-2.5-flash
MENU_IMPORT_GEMINI_TIMEOUT_MS=8000
MENU_IMPORT_ANALYZER_VERSION=menu-import-v3-visual
MENU_IMPORT_GEMINI_PROMPT_VERSION=visual-v1
# Bounded visual-analysis controls; tune server-side only.
MENU_IMPORT_RENDER_MAX_PAGES=40
MENU_IMPORT_RENDER_MAX_WIDTH=2048
MENU_IMPORT_RENDER_MAX_HEIGHT=3072
MENU_IMPORT_RENDER_MAX_BYTES=6291456
MENU_IMPORT_MAX_PROVIDER_CALLS=80
MENU_IMPORT_MAX_RETRIES_PER_PAGE=2
RATE_LIMIT_SALT=

# Optional operational settings.
GUEST_SESSION_TTL_SECONDS=43200
ENABLE_TEST_DATA_RESET=false
NEXT_PUBLIC_ENABLE_KITCHEN_WORKFLOW=false
NEXT_PUBLIC_ENABLE_LOCAL_DEMO=false
