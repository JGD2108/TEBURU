# PostgreSQL database used by the Next.js server.
DATABASE_URL=postgresql://teburu:teburu@localhost:5432/teburu

# Keep destructive test-data reset disabled outside local development.
ENABLE_TEST_DATA_RESET=false

# Supabase Auth for staff sessions. The service key is server-only and is required
# only to provision staff accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
