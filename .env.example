# Public Supabase project values (use a separate project per environment).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never expose these with NEXT_PUBLIC_ prefixes.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
MENU_IMPORT_AUTOMATION_SECRET=
# Optional Gemini text structuring. These are server-only and must never use
# NEXT_PUBLIC_ prefixes. GEMINI_KEY remains supported for local compatibility.
MENU_IMPORT_GEMINI_API_KEY=
GEMINI_KEY=
MENU_IMPORT_GEMINI_MODEL=gemini-2.5-flash
MENU_IMPORT_GEMINI_TIMEOUT_MS=8000
RATE_LIMIT_SALT=

# Optional operational settings.
GUEST_SESSION_TTL_SECONDS=43200
ENABLE_TEST_DATA_RESET=false
NEXT_PUBLIC_ENABLE_KITCHEN_WORKFLOW=false
NEXT_PUBLIC_ENABLE_LOCAL_DEMO=false
